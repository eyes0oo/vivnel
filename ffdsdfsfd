<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchInput');
    const searchBtn = document.getElementById('searchBtn');
    const cards = document.querySelectorAll('.cartochki-card');
    const genreLinks = document.querySelectorAll('.dropdown-item[data-genre]');

    // 1. ПОИСК
    function doSearch() {
        const query = searchInput.value.toLowerCase().trim();
        cards.forEach(card => {
            const titleElement = card.querySelector('.cartochki-text');
            const title = titleElement ? titleElement.textContent.toLowerCase() : '';
            // Скрываем родительский элемент <a>, чтобы не было пустых отступов
            if (title.includes(query)) {
                card.parentElement.style.display = 'block';
            } else {
                card.parentElement.style.display = 'none';
            }
        });
    }
    
    if (searchInput && searchBtn) {
        searchBtn.addEventListener('click', doSearch);
        searchInput.addEventListener('input', doSearch);
    }

    // 2. ФИЛЬТР ЖАНРОВ
    const urlParams = new URLSearchParams(window.location.search);
    const selectedGenre = urlParams.get('genre') || 'all';

    // Подсветка выбранного жанра в меню
    genreLinks.forEach(link => {
        if (link.dataset.genre === selectedGenre) {
            link.classList.add('active');
            link.style.fontWeight = 'bold';
            link.style.backgroundColor = '#e9ecef';
        } else {
            link.classList.remove('active');
            link.style.fontWeight = 'normal';
            link.style.backgroundColor = 'transparent';
        }
    });

    // Применение фильтра к карточкам
    cards.forEach(card => {
        const cardGenre = card.dataset.genre ? card.dataset.genre.toLowerCase() : '';
        const parentLink = card.parentElement; // Это тег <a>

        if (selectedGenre === 'all' || selectedGenre === '' || cardGenre === selectedGenre) {
            parentLink.style.display = 'block';
        } else {
            parentLink.style.display = 'none';
        }
    });
});
</script>

